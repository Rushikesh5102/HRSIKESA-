# ==============================================================================
# HṚṢĪKEŚA (हृषीकेश) — Environment Configuration Template
# Copy this file to .env and configure your desired settings.
# Do NOT commit .env containing real keys or secrets to version control.
# ==============================================================================

# Server & Runtime Configuration
HRISEKESA_PORT=4200
HRISEKESA_HOST=127.0.0.1
HRISEKESA_LOG_LEVEL=info
HRISEKESA_ENV=development

# Local Model Engine (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# Cloud Model Providers (Optional — Leave blank to run purely local)
# Do NOT store real keys here in .env.example
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
